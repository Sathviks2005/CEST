# Server Environment Example Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173
# Google OAuth Configuration
GOOGLE_CLIENT_ID=

# Email / SMTP Configuration
# Example for Gmail (requires 2-Step Verification & 16-character App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<gmail address>
# SMTP_PASS=<16-character Google App Password, requires 2-Step Verification>
# EMAIL_FROM=<same gmail address>
# FROM_NAME=CEST Platform
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
FROM_NAME=CEST Platform

# Groq Wellbeing Assistant Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CHAT_MAX_TURNS=10
CHAT_RATE_LIMIT_PER_MIN=20
